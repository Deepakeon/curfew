{
  "name": "curfew",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android --variant debug",
    "android:debug": "expo run:android --variant debug",
    "android:release": "expo run:android --variant release",
    "build:android:debug": "cd android && ./gradlew assembleDebug",
    "build:android:debug:all": "cd android && ./gradlew assembleDebug",
    "build:android:debug:arm64": "cd android && ./gradlew assembleDebug -PreactNativeArchitectures=arm64-v8a -PuniversalApk=false",
    "build:android:debug:arm32": "cd android && ./gradlew assembleDebug -PreactNativeArchitectures=armeabi-v7a -PuniversalApk=false",
    "build:android:debug:x86_64": "cd android && ./gradlew assembleDebug -PreactNativeArchitectures=x86_64 -PuniversalApk=false",
    "build:android:debug:x86": "cd android && ./gradlew assembleDebug -PreactNativeArchitectures=x86 -PuniversalApk=false",
    "build:android:debug:universal": "cd android && ./gradlew assembleDebug -PenableSplits=false",
    "build:android:release": "cd android && ./gradlew assembleRelease",
    "build:android:release:all": "cd android && ./gradlew assembleRelease",
    "build:android:release:arm64": "cd android && ./gradlew assembleRelease -PreactNativeArchitectures=arm64-v8a -PuniversalApk=false",
    "build:android:release:arm32": "cd android && ./gradlew assembleRelease -PreactNativeArchitectures=armeabi-v7a -PuniversalApk=false",
    "build:android:release:armeabi-v7a": "cd android && ./gradlew assembleRelease -PreactNativeArchitectures=armeabi-v7a -PuniversalApk=false",
    "build:android:release:x86_64": "cd android && ./gradlew assembleRelease -PreactNativeArchitectures=x86_64 -PuniversalApk=false",
    "build:android:release:x86": "cd android && ./gradlew assembleRelease -PreactNativeArchitectures=x86 -PuniversalApk=false",
    "build:android:release:universal": "cd android && ./gradlew assembleRelease -PenableSplits=false",
    "prebuild": "expo prebuild",
    "test": "jest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.1.1",
    "expo": "~57.0.27",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "react": "19.2.3",
    "react-native": "0.86.3"
  },
  "devDependencies": {
    "@expo/config-plugins": "^9.0.0",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.2",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "typescript": "~5.8.2"
  },
  "private": true
}
