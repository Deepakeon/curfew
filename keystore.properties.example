# Curfew Android Release Keystore Configuration Template
# Copy this file to 'keystore.properties' (ignored by git) and set your local release credentials.
# NEVER commit keystore.properties or keystore files to version control.

# Path to the .jks / .keystore file. Supported formats:
# - User home directory path: ~/.android/keys/curfew-release.jks
# - Relative to project root: ./keys/curfew-release.jks or ./curfew-release.jks
# - Absolute filesystem path: /home/username/.android/keys/curfew-release.jks
storeFile=~/.android/keys/curfew-release.jks

# Keystore password
storePassword=your_keystore_password

# Key alias inside the keystore
keyAlias=curfew_release_key

# Key password
keyPassword=your_key_password
